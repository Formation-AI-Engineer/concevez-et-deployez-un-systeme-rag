# Configuration de l'assistant RAG (copier en .env et adapter — NE JAMAIS versionner .env)

# --- Clé API Mistral (génération des réponses) ---
# https://console.mistral.ai/  → API Keys
MISTRAL_API_KEY=changeme

# --- Clé API Open Agenda (récupération des événements) ---
# https://developers.openagenda.com/  → clé publique
OPENAGENDA_API_KEY=changeme

# --- Jeton protégeant POST /rebuild (étape 5) ---
# À fournir dans l'en-tête HTTP `X-API-Token`. Si vide, l'endpoint /rebuild est désactivé.
API_REBUILD_TOKEN=changeme

# --- Modèles ---
# LLM Mistral pour la génération (cf. plateforme Mistral)
MISTRAL_MODEL=mistral-small-latest
# Modèle d'embeddings (HuggingFace, multilingue, exécuté en local)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Périmètre des données (zone + période, cf. énoncé : < 1 an) ---
EVENTS_CITY=Paris
EVENTS_MONTHS_BACK=12

# --- Chemins ---
RAW_DATA_PATH=data/raw/events.json
PROCESSED_DATA_PATH=data/processed/events.parquet
VECTORSTORE_DIR=vectorstore/index

# --- Paramètres RAG ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4
# Seuil de distance cosinus au-delà duquel un document récupéré est jugé non pertinent
# (et écarté). Si tous les voisins dépassent ce seuil -> réponse honnête sans appel LLM.
RELEVANCE_THRESHOLD=0.9
# Filtrage temporel : true (défaut) = ne proposer que les événements À VENIR (date de fin >=
# aujourd'hui) ; les événements sans date exploitable sont conservés. Mettre à false pour rejouer
# une évaluation sur un instantané figé (qui peut contenir des événements passés).
FILTER_PAST_EVENTS=true

# Niveau de log
LOG_LEVEL=INFO
